{
  "name": "bezels",
  "version": "0.1.1",
  "description": "Test web pages on emulated real phones, foldables, tablets and desktops (real browser engines, device frames, safe areas, Telegram Mini Apps), and let Claude Code drive it over MCP.",
  "license": "MIT",
  "author": "n1th1n-19",
  "homepage": "https://github.com/n1th1n-19/Bezels#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n1th1n-19/Bezels.git"
  },
  "bugs": {
    "url": "https://github.com/n1th1n-19/Bezels/issues"
  },
  "keywords": [
    "responsive",
    "device-emulation",
    "mobile-testing",
    "playwright",
    "mcp",
    "claude-code",
    "agent-browser",
    "telegram-mini-app",
    "safe-area",
    "foldable",
    "screenshot",
    "layout-audit"
  ],
  "type": "module",
  "bin": {
    "bezels": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/test",
    "!dist/scripts",
    "!dist/**/*.map",
    "ui/dist",
    "devices.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build ui && chmod +x dist/cli.js",
    "build:core": "tsc -p tsconfig.json",
    "build:ui": "vite build ui",
    "dev:ui": "vite ui",
    "serve": "node dist/cli.js serve",
    "test": "npm run build:core && node --test dist/test/*.test.js",
    "bench": "npm run build:core && node dist/scripts/bench.js",
    "browsers": "playwright install chromium webkit",
    "devices:json": "node dist/cli.js devices --json > devices.json",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "axe-core": "^4.14.0",
    "playwright": "^1.64.1",
    "source-map-js": "^1.2.2",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
